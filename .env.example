# ==============================================================================
# Supabase PostgreSQL Database Configuration
# ==============================================================================
# Session Pooler (port 5432 - recommended for migrations and ingestion):
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Direct Connection (IPv6 / IPv4 add-on):
# postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Transaction Pooler (port 6543 - PgBouncer mode for serverless/high concurrency):
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# NOTE: If using transaction pooler (port 6543), prepared statements must be disabled.
# psycopg handles this automatically when prepare_threshold=None or via script detection.
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ==============================================================================
# Application Configuration
# ==============================================================================
# Default decision cutoff time in Europe/London timezone (24h format HH:MM)
DEFAULT_GATE_CLOSURE_TIME=12:00

# CORS Allowed Origins (comma-separated, include http://localhost:5173 for local dev/Docker)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Frontend API Base URL (passed at build time or local run)
VITE_API_BASE_URL=http://localhost:8000/api

